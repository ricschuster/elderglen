    "rosmarin_2_b": "PLACEHOLDER TEXT. Do you have a moment?",
    "rosmarin_2_ans1": "PLACEHOLDER TEXT. Of course.",
    "rosmarin_2_ans2": "PLACEHOLDER TEXT. I should be going, but go on.",
    "rosmarin_2_r1": "PLACEHOLDER TEXT. Thank you. That means a lot.",
    "rosmarin_2_r2": "PLACEHOLDER TEXT. Then I will be quick.",
