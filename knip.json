{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "tests/**/*.test.ts",
    "scripts/**/*.{ts,mjs}",
    "src/layout/main.ts",
    "electron/main.ts",
    "electron/preload.ts",
    "spikes/m4/pipehost.ts",
    "spikes/m4/pipelisten.ts",
    "src/audio/audition.ts"
  ],
  "project": [
    "src/**/*.ts",
    "electron/**/*.ts",
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreUnresolved": ["^/src/"],
  "ignoreDependencies": ["electron"],
  "ignoreBinaries": ["electron", "ffmpeg"],
  "ignore": ["src/scenes/interior-plans.ts"],
  "ignoreIssues": {
    "src/layout/devserver.ts": ["exports"],
    "src/core/processing.ts": ["duplicates"]
  }
}
