{
  "name": "elderglen",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "items:export": "UPDATE_ITEM_TABLE=1 vitest run tests/itemtable.test.ts",
    "wiki": "node scripts/wiki/build.mjs",
    "wiki:internal": "node scripts/wiki/build.mjs --internal",
    "wiki:images": "node scripts/wiki/images.mjs",
    "wiki:shots": "node scripts/wiki/shots.mjs",
    "wiki:check": "node scripts/wiki/build.mjs --check",
    "overview": "node scripts/overview/build.mjs",
    "overview:refresh": "node scripts/overview/build.mjs --refresh",
    "overview:check": "node scripts/overview/build.mjs --check",
    "valley-map": "node scripts/valley-map/build.mjs",
    "valley-map:check": "node scripts/valley-map/build.mjs --check",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run overview:check && npm run valley-map:check && npm run wiki:check && npm run lint && npm run typecheck && npm test && npm run build",
    "playtest": "node scripts/playtest/play.mjs",
    "playtest:late": "node scripts/playtest/late.mjs",
    "playtest:touch": "node scripts/playtest/touch.mjs",
    "playtest:tap": "node scripts/playtest/tap.mjs",
    "playtest:controls": "node scripts/playtest/controls.mjs",
    "playtest:mouse": "node scripts/playtest/mouse.mjs",
    "playtest:forest": "node scripts/playtest/forest.mjs",
    "playtest:secret-woods": "node scripts/playtest/secret-woods.mjs",
    "playtest:delta": "node scripts/playtest/delta.mjs",
    "playtest:mountain": "node scripts/playtest/mountain.mjs",
    "playtest:forge": "node scripts/playtest/forge.mjs",
    "playtest:farmstead": "node scripts/playtest/farmstead.mjs",
    "playtest:quarry": "node scripts/playtest/quarry.mjs",
    "playtest:beach-elf": "node scripts/playtest/beach-elf.mjs",
    "playtest:cove": "node scripts/playtest/cove.mjs",
    "playtest:hearthwell": "node scripts/playtest/hearthwell.mjs",
    "sim": "node scripts/sim/run.mjs scripts/sim/main.ts",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "node scripts/android/build-apk.mjs",
    "android:install": "node scripts/android/install.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.5"
    },
    "eslint": {
      "minimatch": "^11.0.5"
    }
  }
}
